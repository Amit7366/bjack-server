# Production API — copy to .env on the server (never commit .env).
# Existing: https://bkbajiapi.xyz
# New VPS:  https://api.bkb444.site  (set BASE_URL / CALLBACK_URL / CORS below)

NODE_ENV=production
PORT=5000

BASE_URL=https://api.bkb444.site
CALLBACK_URL=https://api.bkb444.site/api/v1/callback
BKASH_CALLBACK_URL=https://api.bkb444.site/api/v1/bkash/callback

# PipraPay / AutoPay SMS webhook (optional; if set, POST /api/v1/autopay/sms requires header x-autopay-secret)
AUTOPAY_WEBHOOK_SECRET=

# Game bet sync (txserver) — per-user pending records
GAME_TX_PROVIDER_URL=https://txserver.site/testHuidu.php
# Batch ingest target (sync-user POSTs here). Default: http://127.0.0.1:${PORT}/api/v1/gameRecords-txns/api/transactions/ingest
GAME_TX_INGEST_URL=http://127.0.0.1:8000/api/v1/gameRecords-txns/api/transactions/ingest

DATABASE_URL=

BCEYPT_SALT_ROUND=12
DEFAULT_PASS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASS_UI_LINK=https://bkb444.site/auth/reset-password
GAME_LAUNCH_HOME_URL=https://bkb444.site

EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPER_ADMIN_PASSWORD=

PAYMENT_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=

AGENCY_UID=
AES_KEY=
PROVIDER_URL=
PROVIDER_WHITELIST_DOMAIN=api.bkb444.site

PLAYWIN_SECRET_KEY=
PLAYWIN_TOKEN=
PLAYWIN_API_BASE=

LOCAL_REDIS_HOST=redis
LOCAL_REDIS_PORT=6379
VPS_REDIS_HOST=127.0.0.1
VPS_REDIS_PORT=6379
REDIS_PASSWORD=

BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Comma-separated extra CORS origins (frontend URLs)
# Local admin panel: http://localhost:3001
CORS_ORIGINS=https://bkbaji.com,https://www.bkbaji.com,https://admin.bkbaji.com,https://aff.bkbaji.com,https://bkb444.site,https://www.bkb444.site

# PHP tx script should accept ?user=&from= (ms) for incremental vendor fetch
