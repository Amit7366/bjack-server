# Production API — copy to /root/city-server/.env on the VPS (never commit .env).

NODE_ENV=production
PORT=5000

BASE_URL=https://api.city777.shop
CALLBACK_URL=https://api.city777.shop/api/v1/callback
BKASH_CALLBACK_URL=https://api.city777.shop/api/v1/bkash/callback

# PipraPay / AutoPay SMS webhook (optional; if set, POST /api/v1/autopay/sms requires header x-autopay-secret)
AUTOPAY_WEBHOOK_SECRET=

# Game bet sync (txserver) — per-user pending records
GAME_TX_PROVIDER_URL=
GAME_TX_INGEST_URL=http://127.0.0.1:5000/api/v1/gameRecords-txns/api/transactions/ingest

DATABASE_URL=

BCEYPT_SALT_ROUND=12
DEFAULT_PASS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASS_UI_LINK=https://city777.shop/auth/reset-password
GAME_LAUNCH_HOME_URL=https://city777.shop

# Apivexo game return-withdraw + bet ingest cron
GAME_WITHDRAW_URL=https://apivexo.com/api/game/v1/getwithdraw
GAME_API_SECRET=
GAME_API_PREFIX=
GAME_TX_FETCH_URL=https://apivexo.com/api/game/v1/transactions/fetch
GAME_TX_CRON_ENABLED=true

EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPER_ADMIN_PASSWORD=

# View-only guest lock. false = role=viewer can only GET admin APIs.
ADMIN_VIEWER_MUTATIONS_ENABLED=false

PAYMENT_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=

AGENCY_UID=
AES_KEY=
PROVIDER_URL=
PROVIDER_WHITELIST_DOMAIN=api.city777.shop

PLAYWIN_SECRET_KEY=
PLAYWIN_TOKEN=
PLAYWIN_API_BASE=

LOCAL_REDIS_HOST=redis
LOCAL_REDIS_PORT=6379
VPS_REDIS_HOST=127.0.0.1
VPS_REDIS_PORT=6379
REDIS_PASSWORD=

BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Extra CORS origins (city777.shop and *.city777.shop are also allowed in code)
CORS_ORIGINS=https://city777.shop,https://www.city777.shop
