# Production API — copy to .env on the server (never commit .env).
# Set BASE_URL / CALLBACK_URL / CORS to your new VPS domains.

NODE_ENV=production
PORT=5000

BASE_URL=https://api.example.com
CALLBACK_URL=https://api.example.com/api/v1/callback
BKASH_CALLBACK_URL=https://api.example.com/api/v1/bkash/callback

# PipraPay / AutoPay SMS webhook (optional; if set, POST /api/v1/autopay/sms requires header x-autopay-secret)
AUTOPAY_WEBHOOK_SECRET=

# Game bet sync (txserver) — per-user pending records
GAME_TX_PROVIDER_URL=https://txserver.site/testHuidu.php
# Batch ingest target (sync-user POSTs here). Default: http://127.0.0.1:${PORT}/api/v1/gameRecords-txns/api/transactions/ingest
GAME_TX_INGEST_URL=http://127.0.0.1:8000/api/v1/gameRecords-txns/api/transactions/ingest

DATABASE_URL=

BCEYPT_SALT_ROUND=12
DEFAULT_PASS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASS_UI_LINK=https://example.com/auth/reset-password
GAME_LAUNCH_HOME_URL=https://example.com

# Apivexo game return-withdraw + bet ingest cron
GAME_WITHDRAW_URL=https://apivexo.com/api/game/v1/getwithdraw
GAME_API_SECRET=
GAME_API_PREFIX=
GAME_TX_FETCH_URL=https://apivexo.com/api/game/v1/transactions/fetch
GAME_TX_CRON_ENABLED=true

EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPER_ADMIN_PASSWORD=

# View-only guest lock. false = role=viewer can only GET admin APIs.
# Re-enable later: set true and restart the API (no frontend rebuild).
# Create guest as a normal admin, then:
#   db.users.updateOne({ userName: "<guest>" }, { $set: { role: "viewer" } })
# Promote back to full admin:
#   db.users.updateOne({ userName: "<guest>" }, { $set: { role: "admin" } })
ADMIN_VIEWER_MUTATIONS_ENABLED=false

PAYMENT_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=

AGENCY_UID=
AES_KEY=
PROVIDER_URL=
PROVIDER_WHITELIST_DOMAIN=api.example.com

PLAYWIN_SECRET_KEY=
PLAYWIN_TOKEN=
PLAYWIN_API_BASE=

LOCAL_REDIS_HOST=redis
LOCAL_REDIS_PORT=6379
VPS_REDIS_HOST=127.0.0.1
VPS_REDIS_PORT=6379
REDIS_PASSWORD=

BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Comma-separated extra CORS origins (frontend URLs)
# Local admin panel: http://localhost:3001
CORS_ORIGINS=https://example.com,https://www.example.com,https://admin.example.com
