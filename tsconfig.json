{
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "src/data",
    "src/teleSalesLeads/teleSalesLeads.data.ts",
    "src/teleSalesLeads/seedTeleSalesLeads.ts",
    "src/scripts/seedGameCatalog.ts",
    "src/scripts/seedExclusiveGames.ts",
    "src/scripts/seedVendorGames.ts",
    "src/scripts/seedHomeGames.ts",
    "src/scripts/seedGameTypes.ts"
  ],
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
